{
  "name": "gawpoe-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Static Next.js migration for Gaw/Poe LLP",
  "scripts": {
    "dev": "next dev",
    "import:wp": "node scripts/capture-live-site.mjs && node scripts/extract-fragments.mjs && node scripts/capture-head-and-feeds.mjs",
    "sync:sitemap": "node scripts/sync-wp-sitemap.mjs",
    "build": "next build && node scripts/write-redirects.mjs && node scripts/sync-export-to-docs.mjs && npm run check:coverage",
    "check:coverage": "node scripts/check-content-coverage.mjs",
    "start": "npm run preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "refresh:content": "npm run sync:sitemap && node scripts/capture-media.mjs && npm run import:wp",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "compare:live": "node scripts/compare-live.mjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "audit:media": "node scripts/audit-media.mjs",
    "audit:sitemaps": "node scripts/audit-sitemaps.mjs"
  },
  "dependencies": {
    "@hacktoolkit/nextjs-htk": "^0.2.0",
    "classnames": "^2.5.1",
    "next": "^15.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.14",
    "prettier": "^3.5.3",
    "sharp": "^0.35.5",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
