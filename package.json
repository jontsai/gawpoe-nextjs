{
  "name": "gawpoe-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Static Next.js migration for Gaw/Poe LLP",
  "scripts": {
    "dev": "next dev",
    "import:wp": "node src/scripts/import-wordpress.mjs",
    "sync:sitemap": "node scripts/sync-wp-sitemap.mjs",
    "build": "next build && node scripts/sync-export-to-docs.mjs && npm run check:coverage",
    "check:coverage": "node scripts/check-content-coverage.mjs",
    "start": "npm run preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "refresh:content": "npm run import:wp && npm run sync:sitemap",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@hacktoolkit/nextjs-htk": "^0.2.0",
    "classnames": "^2.5.1",
    "next": "^15.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.14",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
