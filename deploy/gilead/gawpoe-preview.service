[Unit]
Description=GawPoe development preview (never production)
After=network.target

[Service]
User=gawpoe
Group=gawpoe
WorkingDirectory=/home/gawpoe/sites/gawpoe.com
ExecStart=/usr/bin/python3 /usr/local/lib/gawpoe-preview/serve-dev-preview.py --root /home/gawpoe/sites/gawpoe.com/out --port 3186
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
